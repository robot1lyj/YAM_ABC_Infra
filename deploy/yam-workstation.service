[Unit]
Description=Wuyan YAM restartable workstation Web/API
After=network-online.target yam-device.service
# Try to start the device owner, but keep the diagnostic UI when it fails/stops.
Wants=network-online.target yam-device.service

[Service]
Type=simple
WorkingDirectory=/data/YAM
Environment=PYTHONUNBUFFERED=1
CPUAffinity=0 1 2 3
ExecStart=/usr/bin/bash /data/YAM/scripts/start_ipc_web.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
