[Unit]
Description=Wuyan YAM restartable workstation Web/API
After=network-online.target yam-device.service
Wants=network-online.target
Requires=yam-device.service

[Service]
Type=simple
WorkingDirectory=/data/YAM
Environment=PYTHONUNBUFFERED=1
CPUAffinity=0 1 2 3
ExecStart=/data/YAM/.venv/bin/yam-workstation --web-only --device-socket=%t/yam-device.sock --web-port 8766 --web-host 192.168.110.140
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
