[Unit]
Description=Wuyan YAM device and acquisition workstation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/YAM
Environment=PYTHONUNBUFFERED=1
# The IPC kernel reserves RK3588's Cortex-A76 cores with isolcpus/nohz_full=4-7.
# A supervised 2026-09-15 motion A/B found that restricting control to only
# cores 4-5 caused perceptible teleoperation jitter. Keep the verified 4-7
# service mask until recording is isolated without narrowing control's cores.
CPUAffinity=4 5 6 7
ExecStart=/data/YAM/.venv/bin/yam-workstation --station /data/YAM/configs/station_hil.yaml --mode collect --url ws://192.168.250.1:8000 --web-port 8766 --web-host 192.168.110.140
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=75

[Install]
WantedBy=default.target
