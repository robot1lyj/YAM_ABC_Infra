+def _align_gripper_limits_to_motor_position(
+    gripper_limits: np.ndarray,
+    motor_position: float,
+) -> np.ndarray:
+    """Move saved hard stops together into the encoder's current 2π turn.
+
+    DM4310 absolute position can return an equivalent angle one full turn away
+    after a controller restart. The calibrated span and open/closed ordering are
+    unchanged, so shift both endpoints together instead of changing motor offset.
+    """
+    limits = np.asarray(gripper_limits, dtype=np.float64)
+    if limits.shape != (2,) or not np.isfinite(limits).all():
+        raise ValueError("gripper limits must contain two finite endpoints")
+    if not np.isfinite(motor_position):
+        raise ValueError("gripper motor position must be finite")
+    turns = np.rint((motor_position - float(np.mean(limits))) / (2 * np.pi))
+    return limits + turns * (2 * np.pi)
+
+
 def _load_joint_limits_from_xml(*xml_paths: str) -> np.ndarray:
     """Parse joint limits (range attributes) from one or more XML files.
 
